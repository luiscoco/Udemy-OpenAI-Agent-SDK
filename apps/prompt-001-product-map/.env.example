# Classroom simulation works immediately with npm start.
# Set these server-side values to enable live model requests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Opt in to hosted session creation when your project has Agents API access.
ENABLE_AGENTS_API=false
# Opt in to local Codex execution after configuring Codex authentication.
ENABLE_CODEX=false
# Optional override of the authenticated Codex model.
CODEX_MODEL=
PORT=3101
